{
  "name": "bigwin-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test:login": "npx playwright test login/",
    "test:lottery-type": "npx playwright test lottery-type/ --project=chromium --headed",
    "test:lottery-type:create": "npx playwright test lottery-type/lottery_type_create.spec.ts",
    "test:lottery-type:edit": "npx playwright test lottery-type/lottery_type_edit.spec.ts",
    "test:lottery-type:delete": "npx playwright test lottery-type/lottery_type_delete.spec.ts",
    "test:lottery-type:search": "npx playwright test lottery-type/lottery_type_search.spec.ts",
    "test:lottery-type:table": "npx playwright test lottery-type/lottery_type_table.spec.ts",
    "test:lottery-type:nav": "npx playwright test lottery-type/lottery_type_nav.spec.ts",
    "test:lottery-type:all": "npx playwright test lottery-type/",
    "test:lottery-type:ci": "npx playwright test lottery-type/ --reporter=list,json,html,allure-playwright",
    "test:allure": "node scripts/test-with-allure.js",
    "test:network-rerun": "node scripts/run-with-network-rerun.js",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.4",
    "allure-playwright": "^3.9.0",
    "chart.js": "^4.5.1",
    "eslint": "^9.14.0",
    "eslint-plugin-playwright": "^2.0.1",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.3.5",
    "globals": "^15.12.0",
    "html-pdf-node": "^1.0.8",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "xlsx": "^0.18.5"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
