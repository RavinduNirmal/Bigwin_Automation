# Template for .env - copy to .env and fill in real values. Do NOT put real credentials here:
# this file is committed to git.

# Test Environment (dev | staging | prod) - selects config/env/<TEST_ENV>.json
TEST_ENV=staging

# Base URLs
BASE_URL=http://<host>:<port>
API_BASE_URL=http://<host>:<port>/api

# Test Credentials
ADMIN_USERNAME=<admin-username>
ADMIN_PASSWORD=<admin-password>

# Test Configuration
TEST_TIMEOUT=60000
RETRY_COUNT=2
PARALLEL_WORKERS=1

# Debug Mode
DEBUG=false

# Report Configuration
ALLURE_RESULTS_DIR=allure-results
PLAYWRIGHT_REPORT_DIR=playwright-report
